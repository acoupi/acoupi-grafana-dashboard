      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "acoupi-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  devices.device_name AS device,\n  recordings.recorded_on,\n  recordings.duration_seconds,\n  recordings.sample_rate_hz,\n  recordings.audio_channels,\n  recordings.bit_depth,\n  recordings.recording_uuid\nFROM recordings\nJOIN devices ON devices.id = recordings.device_id\nORDER BY recordings.recorded_on DESC\nLIMIT 20;",
          "refId": "A"
        }
      ],
      "title": "Latest Recordings",
      "type": "table"
