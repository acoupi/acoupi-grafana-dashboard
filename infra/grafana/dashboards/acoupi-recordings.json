      "id": 1,
      "targets": [
        {
          "refId": "A",
          "rawSql": "\nSELECT\n  recordings.recorded_on AS time,\n  recordings.recorded_on + make_interval(secs => recordings.duration_seconds) AS timeend,\n  devices.device_name AS device\nFROM recordings\nJOIN devices ON devices.id = recordings.device_id\nWHERE recordings.recorded_on >= $__timeFrom()\n  AND recordings.recorded_on <= $__timeTo()\nORDER BY devices.device_name, recordings.recorded_on;\n",
          "rawQuery": true,
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "acoupi-postgres"
          }
        }
      ],
      "title": "Recording Coverage Per Device",
      "datasource": {
        "type": "postgres",
        "uid": "acoupi-postgres"
      },
