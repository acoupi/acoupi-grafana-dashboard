      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "acoupi-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (device_id)\n  device_id,\n  received_at,\n  payload_device_id,\n  COALESCE(payload->>'status', 'UNKNOWN') AS status,\n  topic\nFROM mqtt_messages\nWHERE message_type = 'heartbeat'\n  AND ingest_status = 'accepted'\nORDER BY device_id, received_at DESC;",
          "refId": "A"
        }
      ],
      "title": "Latest Heartbeat Per Device",
      "type": "table"
    }
