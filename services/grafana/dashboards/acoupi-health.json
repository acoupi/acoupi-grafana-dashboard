      "id": 2,
      "targets": [
        {
          "refId": "A",
          "rawSql": "\nSELECT DISTINCT ON (device_id)\n  device_id,\n  received_at,\n  payload_device_id,\n  COALESCE(payload->>'status', 'UNKNOWN') AS status,\n  topic\nFROM mqtt_messages\nWHERE message_type = 'heartbeat'\n  AND ingest_status = 'accepted'\nORDER BY device_id, received_at DESC;\n",
          "rawQuery": true,
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "acoupi-postgres"
          }
        }
      ],
      "title": "Latest Heartbeat Per Device",
