      "id": 11,
      "targets": [
        {
          "refId": "A",
          "rawSql": "\nWITH latest_heartbeats AS (\n  SELECT\n    device_id,\n    MAX(received_at) AS last_heartbeat_at\n  FROM mqtt_messages\n  WHERE message_type = 'heartbeat'\n    AND ingest_status = 'accepted'\n  GROUP BY device_id\n)\nSELECT COUNT(*)::double precision AS value\nFROM devices\nLEFT JOIN latest_heartbeats ON latest_heartbeats.device_id = devices.device_name\nWHERE latest_heartbeats.last_heartbeat_at IS NULL\n   OR latest_heartbeats.last_heartbeat_at < NOW() - INTERVAL '6 hours';\n",
          "rawQuery": true,
          "format": "table",
          "datasource": {
            "type": "postgres",
            "uid": "acoupi-postgres"
          }
        }
      ],
      "title": "Unhealthy Devices",
      "description": "Shows devices missing a heartbeat for more than six hours.",
