      "id": 5,
      "targets": [
        {
          "refId": "A",
          "rawSql": "\nSELECT received_at, device_id, payload_device_id, message_type, topic, ingest_status\nFROM mqtt_messages\nORDER BY received_at DESC\nLIMIT 100;\n",
          "rawQuery": true,
          "format": "table",
          "datasource": {
            "type": "postgres",
