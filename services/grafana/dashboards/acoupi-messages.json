      "id": 1,
      "targets": [
        {
          "refId": "A",
          "rawSql": "\nSELECT $__timeGroupAlias(received_at, '1m'), COUNT(*)::double precision AS value\nFROM mqtt_messages\nWHERE $__timeFilter(received_at)\nGROUP BY 1\nORDER BY 1;\n",
          "rawQuery": true,
          "format": "time_series",
          "datasource": {
            "type": "postgres",
            "uid": "acoupi-postgres"
          }
        }
      ],
      "title": "Messages Over Time",
      "description": "Shows total MQTT messages received over time.",
      "datasource": {
        "type": "postgres",
        "uid": "acoupi-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
